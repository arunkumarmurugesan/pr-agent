# PR-Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenAI API Key (Required)
# Get this from: https://platform.openai.com/settings/organization/api-keys
OPENAI_KEY=sk-your-openai-api-key-here

# GitHub Token (Optional for local testing, automatically provided in GitHub Actions)
# Get this from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your-github-token-here

# Repository Information (Optional)
GITHUB_REPOSITORY=arunkumarmurugesan/pr-agent
GITHUB_PR_NUMBER=1

# OpenAI Model Configuration (Optional)
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=4000
